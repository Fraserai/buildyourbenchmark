# --- Required secrets (generated by `pnpm bootstrap`) ---
# 32-byte base64 key used to encrypt uploaded task files at rest (AES-256-GCM).
DATA_ENCRYPTION_KEY=
# Secret used to sign short-lived file download URLs.
SIGNING_SECRET=

# --- Storage ---
DATABASE_PATH=./data/workbench.db
STORAGE_DIR=./storage

# --- Inference providers (live runs). Keys never leave the server. ---
# One OpenRouter key routes every catalogue model and returns the billed cost per request.
OPENROUTER_API_KEY=
# Optional: call Claude models directly through Anthropic's API.
ANTHROPIC_API_KEY=
# Route preference when several providers can serve a model (comma-separated).
INFERENCE_PROVIDER_PRIORITY=anthropic,openrouter

# --- Model catalogue ---
# Optional: authoritative Artificial Analysis reference data.
ARTIFICIAL_ANALYSIS_API_KEY=
# Hours between automatic catalogue refreshes performed by the worker.
CATALOGUE_REFRESH_HOURS=6

# --- Worker ---
# Run the execution worker inside the Next.js server process (set false when running `pnpm worker` separately).
WORKER_INPROCESS=true
WORKER_CONCURRENCY=8
